# Copia este archivo a .env.local y rellena los valores desde tu proyecto de Supabase
# (Supabase -> Project Settings -> API)

# URL del proyecto (publica, se usa tambien en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave "anon" (publica, solo sirve para el login del admin; las tablas estan
# protegidas con RLS y esta clave NO puede leer ni escribir datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave "service_role" (SECRETA - solo vive en el servidor, NUNCA la subas a git
# ni la pongas en codigo del navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Emails (opcional pero recomendado) ---
# Cuenta de Gmail del negocio para enviar confirmaciones y recordatorios.
# GMAIL_APP_PASSWORD es una "contrasena de aplicacion" de Google
# (myaccount.google.com -> Seguridad -> Verificacion en 2 pasos -> Contrasenas de aplicaciones)
GMAIL_USER=fennanibarbershop@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Protege el cron de recordatorios (pon cualquier cadena larga aleatoria;
# Vercel la envia automaticamente en sus crons si existe como variable)
CRON_SECRET=cadena-larga-aleatoria
