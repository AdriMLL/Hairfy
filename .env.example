# Copia este archivo a .env.local y rellena los valores desde tu proyecto de Supabase
# (Supabase -> Project Settings -> API)

# URL del proyecto (publica, se usa tambien en el navegador)
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave "anon" (publica, solo sirve para el login del admin; las tablas estan
# protegidas con RLS y esta clave NO puede leer ni escribir datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Clave "service_role" (SECRETA - solo vive en el servidor, NUNCA la subas a git
# ni la pongas en codigo del navegador)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
